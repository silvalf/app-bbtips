<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BBTipsManager.App.ViewModels"
             x:Class="BBTipsManager.App.Pages.BancaDetalhePage"
             x:DataType="vm:BancaDetalheViewModel"
             Title="{Binding Banca.Nome}">
    
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Accent}"/>
            
            <!-- Info da Banca -->
            <Frame Style="{StaticResource CardFrame}">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                    
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                        <Label Text="Saldo Atual" Style="{StaticResource MutedLabel}"/>
                        <Label Text="{Binding Banca.SaldoAtual, StringFormat='R$ {0:N2}'}" 
                               FontSize="20" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                        <Label Text="Lucro/Prejuizo" Style="{StaticResource MutedLabel}"/>
                        <Label Text="{Binding Banca.LucroTotal, StringFormat='R$ {0:N2}'}" 
                               FontSize="20" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                        <Label Text="Saldo Inicial" Style="{StaticResource MutedLabel}"/>
                        <Label Text="{Binding Banca.SaldoInicial, StringFormat='R$ {0:N2}'}"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                        <Label Text="Percentual" Style="{StaticResource MutedLabel}"/>
                        <Label Text="{Binding Banca.PercentualLucro, StringFormat='{0:N1}%'}"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Row="2" Grid.Column="0">
                        <Label Text="Assertividade" Style="{StaticResource MutedLabel}"/>
                        <Label Text="{Binding Banca.Assertividade, StringFormat='{0:N1}%'}" 
                               TextColor="{StaticResource Success}"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                        <Label Text="Operacoes" Style="{StaticResource MutedLabel}"/>
                        <Label Text="{Binding Banca.TotalOperacoes}"/>
                    </VerticalStackLayout>
                    
                    <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="8">
                        <Label Text="Stop Loss:" Style="{StaticResource MutedLabel}"/>
                        <Label Text="{Binding Banca.StopLoss, StringFormat='{0}%'}" 
                               TextColor="{StaticResource Danger}"/>
                        <Label Text="| Stop Gain:" Style="{StaticResource MutedLabel}"/>
                        <Label Text="{Binding Banca.StopGain, StringFormat='{0}%'}" 
                               TextColor="{StaticResource Success}"/>
                    </HorizontalStackLayout>
                </Grid>
            </Frame>
            
            <!-- Botoes de Acao -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="+ Operacao" 
                        Command="{Binding ToggleNovaOperacaoCommand}"/>
                <Button Grid.Column="1" Text="Pausar" 
                        Command="{Binding PausarBancaCommand}"
                        Style="{StaticResource SecondaryButton}"/>
                <Button Grid.Column="2" Text="Ativar" 
                        Command="{Binding AtivarBancaCommand}"
                        Style="{StaticResource SuccessButton}"/>
            </Grid>
            
            <!-- Form Nova Operacao -->
            <Frame Style="{StaticResource CardFrame}" IsVisible="{Binding ShowNovaOperacao}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nova Operacao" FontAttributes="Bold"/>
                    
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Stake" Style="{StaticResource MutedLabel}"/>
                            <Entry Text="{Binding NovaOperacaoStake}" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Odd" Style="{StaticResource MutedLabel}"/>
                            <Entry Text="{Binding NovaOperacaoOdd}" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                    </Grid>
                    
                    <Entry Placeholder="Evento (ex: Flamengo x Palmeiras)" 
                           Text="{Binding NovaOperacaoEvento}"/>
                    <Entry Placeholder="Placar esperado (ex: 0x0)" 
                           Text="{Binding NovaOperacaoPlacar}"/>
                    
                    <Button Text="Registrar Operacao" 
                            Command="{Binding RegistrarOperacaoCommand}"
                            Style="{StaticResource SuccessButton}"/>
                </VerticalStackLayout>
            </Frame>
            
            <!-- Historico de Operacoes -->
            <Label Text="Historico de Operacoes" Style="{StaticResource SubtitleLabel}"/>
            
            <CollectionView ItemsSource="{Binding Operacoes}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="core:Operacao">
                        <Frame Style="{StaticResource CardFrame}" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                
                                <Label Grid.Row="0" Grid.Column="0" 
                                       Text="{Binding Evento}" FontAttributes="Bold"/>
                                
                                <Label Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding Status}" FontAttributes="Bold"/>
                                
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="16">
                                    <Label Text="{Binding Stake, StringFormat='Stake: R$ {0:N2}'}" 
                                           Style="{StaticResource MutedLabel}"/>
                                    <Label Text="{Binding Odd, StringFormat='Odd: {0:N2}'}" 
                                           Style="{StaticResource MutedLabel}"/>
                                </HorizontalStackLayout>
                                
                                <Label Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding LucroPrejuizo, StringFormat='R$ {0:N2}'}"
                                       FontAttributes="Bold"/>
                                
                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" 
                                                       Spacing="8" IsVisible="{Binding Status, Converter={x:Static local:Converters.IsPendenteConverter}}">
                                    <Button Text="Ganhou" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BancaDetalheViewModel}}, Path=MarcarGanhouCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource SuccessButton}"
                                            HeightRequest="35" FontSize="12"/>
                                    <Button Text="Perdeu" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BancaDetalheViewModel}}, Path=MarcarPerdeuCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource DangerButton}"
                                            HeightRequest="35" FontSize="12"/>
                                </HorizontalStackLayout>
                                
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Nenhuma operacao registrada" 
                           Style="{StaticResource MutedLabel}" 
                           HorizontalOptions="Center"/>
                </CollectionView.EmptyView>
            </CollectionView>
            
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
