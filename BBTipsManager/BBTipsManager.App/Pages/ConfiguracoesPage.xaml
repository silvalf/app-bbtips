<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BBTipsManager.App.ViewModels"
             xmlns:conv="clr-namespace:BBTipsManager.App"
             x:Class="BBTipsManager.App.Pages.ConfiguracoesPage"
             x:DataType="vm:ConfiguracoesViewModel"
             Title="Configurações">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Alerta de Feedback Visual (Snackbar Style) -->
            <Frame IsVisible="{Binding CurrentAlertSeverity, Converter={x:Static conv:Converters.InverseBoolConverter}}"
                   BackgroundColor="{Binding CurrentAlertSeverity, Converter={x:Static conv:Converters.SeverityToColorConverter}}"
                   CornerRadius="8"
                   Padding="12">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{Binding CurrentAlertSeverity, Converter={x:Static conv:Converters.SeverityToIconConverter}}"
                           FontSize="24"
                           TextColor="White"
                           VerticalOptions="Center"/>
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="White"
                           VerticalOptions="Center"
                           FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </Frame>

            <Label Text="Configurações" Style="{StaticResource TitleLabel}"/>

            <!-- ========================================= -->
            <!-- SEÇÃO: Credenciais BB Tips (Grid) -->
            <!-- ========================================= -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🔐 Credenciais BB Tips" FontAttributes="Bold" FontSize="18"/>
                    <Label Text="Gerencie suas credenciais de acesso" Style="{StaticResource MutedLabel}"/>

                    <!-- Grid de Credenciais -->
                    <CollectionView ItemsSource="{Binding Credenciais}" 
                                    HeightRequest="150"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding CredencialSelecionada}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="8" Margin="0,4" BackgroundColor="{Binding EhPrincipal, Converter={x:Static conv:Converters.BoolToAccentColorConverter}}">
                                    <HorizontalStackLayout Spacing="8">
                                        <VerticalStackLayout HorizontalOptions="FillAndExpand">
                                            <Label Text="{Binding Nome}" FontAttributes="Bold"/>
                                            <Label Text="{Binding Email}" Style="{StaticResource MutedLabel}" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <Label Text="⭐" IsVisible="{Binding EhPrincipal}" VerticalOptions="Center"/>
                                        <Button Text="✏️" FontSize="14" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ConfiguracoesViewModel}}, Path=SelecionarCredencialCommand}"
                                                CommandParameter="{Binding .}"
                                                WidthRequest="36" HeightRequest="36" Padding="0"/>
                                        <Button Text="🗑️" FontSize="14" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ConfiguracoesViewModel}}, Path=ExcluirCredencialCommand}"
                                                CommandParameter="{Binding .}"
                                                WidthRequest="36" HeightRequest="36" Padding="0"/>
                                    </HorizontalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Formulário de Nova/Edição Credencial -->
                    <Frame BackgroundColor="{StaticResource Secondary}" Padding="12" CornerRadius="8">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding CredencialSelecionada, Converter={x:Static conv:Converters.NullToTextConverter}, ConverterParameter='Nova Credencial|Edição: '}" 
                                   FontAttributes="Bold"/>

                            <Entry Placeholder="Nome identificador" Text="{Binding CredencialNome}"/>
                            <Entry Placeholder="E-mail" Text="{Binding CredencialEmail}" Keyboard="Email"/>
                            <Entry Placeholder="Senha" Text="{Binding CredencialSenha}" IsPassword="True"/>
                            <Entry Placeholder="URL Base" Text="{Binding CredencialUrlBase}"/>

                            <HorizontalStackLayout Spacing="20">
                                <VerticalStackLayout>
                                    <Label Text="Timeout (s)" FontSize="12" Style="{StaticResource MutedLabel}"/>
                                    <Entry Keyboard="Numeric" Text="{Binding CredencialTimeoutSegundos}" WidthRequest="80"/>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <CheckBox IsChecked="{Binding CredencialModoDebug}" Color="{StaticResource Accent}"/>
                                    <Label Text="Debug" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <CheckBox IsChecked="{Binding CredencialEhPrincipal}" Color="{StaticResource Accent}"/>
                                    <Label Text="Principal" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                <Button Text="🧹 Limpar" Command="{Binding LimparFormularioCredencialCommand}" Style="{StaticResource SecondaryButton}"/>
                                <Button Text="💾 Salvar" Command="{Binding SalvarCredencialCommand}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- ========================================= -->
            <!-- SEÇÃO: Configurações Gerais -->
            <!-- ========================================= -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="⚙️ Configurações Gerais" FontAttributes="Bold" FontSize="18"/>

                    <!-- Notificações -->
                    <Label Text="Notificações" FontAttributes="Bold" FontSize="14" Margin="0,8,0,4"/>
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding NotificacoesAtivas}" Color="{StaticResource Accent}"/>
                        <Label Text="Notificações ativas" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding SomAlerta}" Color="{StaticResource Accent}"/>
                        <Label Text="Som de alerta" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Auto-refresh -->
                    <VerticalStackLayout>
                        <Label Text="Auto-refresh (segundos)" Style="{StaticResource MutedLabel}"/>
                        <Entry Keyboard="Numeric" Text="{Binding IntervaloAtualizacao}"/>
                    </VerticalStackLayout>

                    <!-- Aparência -->
                    <Label Text="Aparência" FontAttributes="Bold" FontSize="14" Margin="0,8,0,4"/>
                    <VerticalStackLayout>
                        <Label Text="Tema" Style="{StaticResource MutedLabel}"/>
                        <Picker SelectedItem="{Binding TemaAplicacao}">
                            <Picker.Items>
                                <x:String>Dark</x:String>
                                <x:String>Light</x:String>
                                <x:String>System</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding IniciarComWindows}" Color="{StaticResource Accent}"/>
                        <Label Text="Iniciar com Windows" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Botão Salvar Configurações Gerais -->
                    <Button Text="💾 Salvar Configurações Gerais" 
                            Command="{Binding SalvarConfiguracoesGeraisCommand}"
                            HeightRequest="45"
                            Margin="0,8,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- ========================================= -->
            <!-- SEÇÃO: Sobre -->
            <!-- ========================================= -->
            <Frame Style="{StaticResource CardFrame}" BackgroundColor="{StaticResource Secondary}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ℹ️ Sobre o App" FontAttributes="Bold"/>
                    <Label Text="BB Tips Manager v1.0" Style="{StaticResource MutedLabel}"/>
                    <Label Text="Sistema de gestão de bancas e padrões para apostas esportivas com proteção de capital e estratégias de alavancagem controlada." 
                           Style="{StaticResource MutedLabel}"/>
                </VerticalStackLayout>
            </Frame>

            <ActivityIndicator IsRunning="{Binding IsSaving}"
                               IsVisible="{Binding IsSaving}"
                               Color="{StaticResource Accent}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
