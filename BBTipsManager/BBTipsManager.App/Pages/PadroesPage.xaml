<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BBTipsManager.App.ViewModels"
             x:Class="BBTipsManager.App.Pages.PadroesPage"
             x:DataType="vm:PadroesViewModel"
             Title="Padroes">
    
    <Grid RowDefinitions="Auto,*">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="16" Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Padroes" Style="{StaticResource TitleLabel}"/>
                    <Label Text="Gerencie seus padroes de apostas" Style="{StaticResource SubtitleLabel}"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="+ Novo Padrao" 
                        Command="{Binding ToggleNovoPadraoCommand}"
                        VerticalOptions="Center"/>
            </Grid>
            
            <!-- Form Novo Padrao -->
            <Frame Style="{StaticResource CardFrame}" IsVisible="{Binding ShowNovoPadrao}" Margin="0,8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Novo Padrao" FontAttributes="Bold" FontSize="16"/>
                    
                    <Entry Placeholder="Nome do Padrao" Text="{Binding NovoPadraoNome}"/>
                    <Entry Placeholder="Descricao" Text="{Binding NovoPadraoDescricao}"/>
                    
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Odd Minima" Style="{StaticResource MutedLabel}"/>
                            <Entry Text="{Binding NovoPadraoOddMinima}" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Odd Media" Style="{StaticResource MutedLabel}"/>
                            <Entry Text="{Binding NovoPadraoOddMedia}" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="Odd Maxima" Style="{StaticResource MutedLabel}"/>
                            <Entry Text="{Binding NovoPadraoOddMaxima}" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                    </Grid>
                    
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Placar" Style="{StaticResource MutedLabel}"/>
                            <Entry Placeholder="0x0" Text="{Binding NovoPadraoPlacar}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Assertividade (%)" Style="{StaticResource MutedLabel}"/>
                            <Entry Text="{Binding NovoPadraoAssertividade}" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                    </Grid>
                    
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Total Jogos" Style="{StaticResource MutedLabel}"/>
                            <Entry Text="{Binding NovoPadraoTotalJogos}" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Total Acertos" Style="{StaticResource MutedLabel}"/>
                            <Entry Text="{Binding NovoPadraoTotalAcertos}" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                    </Grid>
                    
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Liga" Style="{StaticResource MutedLabel}"/>
                            <Entry Placeholder="Ex: Brasileirao" Text="{Binding NovoPadraoLiga}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Mercado" Style="{StaticResource MutedLabel}"/>
                            <Picker ItemsSource="{Binding Mercados}" 
                                    SelectedItem="{Binding NovoPadraoMercadoSelecionado}"/>
                        </VerticalStackLayout>
                    </Grid>
                    
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Minuto Inicio" Style="{StaticResource MutedLabel}"/>
                            <Entry Text="{Binding NovoPadraoMinutoInicio}" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Minuto Fim" Style="{StaticResource MutedLabel}"/>
                            <Entry Text="{Binding NovoPadraoMinutoFim}" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                    </Grid>
                    
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="Cancelar" 
                                Command="{Binding ToggleNovoPadraoCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                        <Button Grid.Column="1" Text="Salvar" 
                                Command="{Binding SalvarNovoPadraoCommand}"
                                Style="{StaticResource SuccessButton}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
        
        <!-- Lista de Padroes -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,0" Spacing="8">
                <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Accent}"/>
                
                <CollectionView ItemsSource="{Binding Padroes}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="core:Padrao">
                            <Frame Style="{StaticResource CardFrame}" Margin="0,4">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                    
                                    <Label Grid.Row="0" Grid.Column="0" 
                                           Text="{Binding Nome}" FontAttributes="Bold" FontSize="16"/>
                                    
                                    <Frame Grid.Row="0" Grid.Column="1" 
                                           Padding="8,4" CornerRadius="4" HasShadow="False"
                                           BackgroundColor="{StaticResource Success}">
                                        <Label Text="{Binding Assertividade, StringFormat='{0:N0}%'}" 
                                               FontSize="12" FontAttributes="Bold" TextColor="White"/>
                                    </Frame>
                                    
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" 
                                           Text="{Binding Descricao}" Style="{StaticResource MutedLabel}"/>
                                    
                                    <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="16">
                                        <Label Text="{Binding OddMedia, StringFormat='Odd: {0:N2}'}" FontSize="12"/>
                                        <Label Text="{Binding Placar, StringFormat='Placar: {0}'}" FontSize="12"/>
                                        <Label Text="{Binding Liga}" FontSize="12" Style="{StaticResource MutedLabel}"/>
                                    </HorizontalStackLayout>
                                    
                                    <HorizontalStackLayout Grid.Row="3" Grid.Column="0" Spacing="8">
                                        <Label Text="{Binding TotalAcertos, StringFormat='{0} acertos'}" 
                                               FontSize="12" TextColor="{StaticResource Success}"/>
                                        <Label Text="/" FontSize="12" Style="{StaticResource MutedLabel}"/>
                                        <Label Text="{Binding TotalJogos, StringFormat='{0} jogos'}" 
                                               FontSize="12" Style="{StaticResource MutedLabel}"/>
                                    </HorizontalStackLayout>
                                    
                                    <Button Grid.Row="3" Grid.Column="1" 
                                            Text="X" WidthRequest="35" HeightRequest="35"
                                            BackgroundColor="{StaticResource Danger}" FontSize="12"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PadroesViewModel}}, Path=ExcluirPadraoCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
                            <Label Text="Nenhum padrao cadastrado" 
                                   Style="{StaticResource SubtitleLabel}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Cadastre padroes do BB Tips para usar nas bancas" 
                                   Style="{StaticResource MutedLabel}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        
    </Grid>
    
</ContentPage>
